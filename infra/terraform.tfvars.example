# Copie para terraform.tfvars (gitignored) para uso local:
#   cp terraform.tfvars.example terraform.tfvars
#
# Nao ha variaveis obrigatorias: o endereco do ALB vem do SSM (/oficina/<env>/alb-url, gravado pelo deploy
# dos servicos) e o service-token do Secrets Manager (criado pelo infra/ do OS Service).
# Sobrescreva so o que precisar, por exemplo:
# enable_authorizer = false
